import tkinter as tk
from tkinter import font

class ScoreboardApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Tableau de Scores")
        self.root.geometry("400x300")

        # Charger les images des équipes (remplacez par vos propres images)
        self.team1_image = tk.PhotoImage(file="team1.png").subsample(2, 2)
        self.team2_image = tk.PhotoImage(file="team2.png").subsample(2, 2)

        # Créer les labels pour les images des équipes
        self.team1_label = tk.Label(root, image=self.team1_image)
        self.team1_label.grid(row=0, column=0, padx=10, pady=10)

        self.team2_label = tk.Label(root, image=self.team2_image)
        self.team2_label.grid(row=0, column=2, padx=10, pady=10)

        # Créer les labels pour les noms des équipes
        self.team1_name = tk.Label(root, text="Équipe 1", font=("Arial", 16))
        self.team1_name.grid(row=1, column=0, padx=10, pady=10)

        self.team2_name = tk.Label(root, text="Équipe 2", font=("Arial", 16))
        self.team2_name.grid(row=1, column=2, padx=10, pady=10)

        # Créer les labels pour les scores
        self.team1_score = tk.Label(root, text="0", font=("Arial", 24))
        self.team1_score.grid(row=2, column=0, padx=10, pady=10)

        self.team2_score = tk.Label(root, text="0", font=("Arial", 24))
        self.team2_score.grid(row=2, column=2, padx=10, pady=10)

        # Créer les boutons pour augmenter les scores
        self.team1_button = tk.Button(root, text="+1", command=self.increase_team1_score)
        self.team1_button.grid(row=3, column=0, padx=10, pady=10)

        self.team2_button = tk.Button(root, text="+1", command=self.increase_team2_score)
        self.team2_button.grid(row=3, column=2, padx=10, pady=10)

    def increase_team1_score(self):
        current_score = int(self.team1_score["text"])
        self.team1_score["text"] = str(current_score + 1)

    def increase_team2_score(self):
        current_score = int(self.team2_score["text"])
        self.team2_score["text"] = str(current_score + 1)

if __name__ == "__main__":
    root = tk.Tk()
    app = ScoreboardApp(root)
    root.mainloop()
